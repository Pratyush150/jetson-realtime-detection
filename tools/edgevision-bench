#!/usr/bin/env python3
"""Thin launcher so the CLI works from a source checkout without installing."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from edgevision.cli import main_bench  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main_bench())
